{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Shared website files that Node's test runner loads import each other
    // with ".ts" (src/lib/checklist-matching.ts). Metro resolves them as written.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@shared/*": ["../src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
